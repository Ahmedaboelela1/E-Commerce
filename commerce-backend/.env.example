# Skillverse backend — use hosting platform secret variables. Never commit your .env.
APP_ENV=dev
# Low-volume pilot: one API service also runs SQL-backed jobs and scheduled tasks.
# If changing to separate worker services later, set false and start worker.
RUN_JOBS_IN_SERVER=true
# Enable ONLY for first deployment of the owner's approved empty database.
# Remove after countries appear in Dashboard; subsequent boots skip if already seeded.
HOSTINGER_INITIALIZE_COUNTRIES=NO
PORT=3000
# Hostinger MySQL database name supplied by project owner:
DB_NAME=u169469823_store
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=REPLACE_WITH_MYSQL_USER
DB_PASSWORD=REPLACE_IN_HOSTING_ONLY
# Optional: only enable if remote MySQL offers trusted TLS
DB_SSL=false
# Must be a unique random secret (32+ bytes); never use this placeholder:
COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET
# Initial superadmin credentials, not a publicly known default:
SUPERADMIN_USERNAME=REPLACE_WITH_ADMIN_EMAIL
SUPERADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Vendure server public URL and storefront origin:
BACKEND_PUBLIC_URL=https://YOUR-BACKEND-HOST.example
STOREFRONT_PUBLIC_URL=https://shop.skillverse-global.com
CORS_ORIGINS=https://shop.skillverse-global.com
ASSET_URL_PREFIX=https://YOUR-BACKEND-HOST.example/assets/
# Hostinger same-account Node.js + MySQL: use 127.0.0.1; do not enable remote access.
# Keep real passwords in Hostinger Environment Variables only.
